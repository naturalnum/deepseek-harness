{
  "name": "deepscientist-harness-suite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.14.0",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./plugins/workbench/index.mjs",
    "./airalogy": "./plugins/airalogy/index.mjs",
    "./research": "./plugins/deepscientist/index.mjs",
    "./workbench": "./plugins/workbench/index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node dist/server/main.mjs",
    "mcp": "node dist/server/mcp.mjs",
    "install:suite": "node scripts/install.mjs",
    "start:all": "node scripts/start-all.mjs",
    "doctor": "node scripts/doctor.mjs",
    "mcp:config": "node scripts/mcp-config.mjs",
    "test:harness": "node scripts/harness-runtime-test.mjs",
    "test:profile": "node scripts/plugin-integration-check.mjs --generic",
    "test:engine": "node --test tests/engine.integration.mjs tests/interactive.integration.mjs tests/research-tasks.integration.mjs"
  },
  "dependencies": {
    "@airalogy/aimd-core": "2.15.0",
    "@arco-design/web-react": "2.66.1",
    "@icon-park/react": "1.4.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "i18next": "25.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.8.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "ajv": "8.17.1",
    "esbuild": "0.25.11",
    "prettier": "3.6.2"
  }
}

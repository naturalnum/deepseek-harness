# Standalone compatibility template only. Cloud uses cloud/README.md and the original account profile.
# Do not use these global process variables to configure the multiuser cloud integration.
DS_HARNESS_PUBLIC_URL=https://portal.example.invalid/
DS_RESEARCH_PUBLIC_URL=https://portal.example.invalid/research/

# Private persistent data for ONE authenticated account, outside versioned code.
# The platform must derive this path from a verified account, never a browser field.
DS_RESEARCH_DATA_DIR=/srv/epri-research/accounts/ACCOUNT_STORAGE_KEY/research
DS_SUITE_HOME=/srv/epri-research/accounts/ACCOUNT_STORAGE_KEY/harness
DS_RESEARCH_PORT=43127

# Optional restricted worker. Supply a real token FILE via deployment secrets.
# DS_ENGINE_URL=http://127.0.0.1:43129
# DS_ENGINE_TOKEN_FILE=/run/secrets/research-engine-token

# This template does NOT activate platform SSO or tenant routing.
# Do not expose this account service or Docker socket directly to clients.

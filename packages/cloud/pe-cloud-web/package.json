{
  "name": "@deepseek-ai/dsh-pe-cloud-web",
  "version": "0.2.1-rc.2",
  "description": "PowerEvolve login presentation and account page lifecycle over the native Web boot",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/cloud/pe-cloud-web"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",

{
  "name": "@deepseek-ai/dsh-pe-opensandbox",
  "version": "0.2.1-rc.2",
  "description": "Account-bound OpenSandbox execution composition and admission",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./root": {
      "types": "./lib/types/root.d.ts",
      "default": "./lib/root.js"
    },
    "./account": {
      "types": "./lib/types/account.d.ts",
      "default": "./lib/account.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-pe-cloud-runtime": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-pe-cloud-runtime": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/cloud/pe-opensandbox"
  }
}

    "title_en": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "series_no": {"type": "string"},
    "cooperator": {"type": ["string", "array"]},
    "report_date": {"type": "string", "minLength": 1},

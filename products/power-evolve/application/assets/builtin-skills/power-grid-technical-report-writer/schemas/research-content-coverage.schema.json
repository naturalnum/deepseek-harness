{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Content Subpoint Coverage Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_theme_type",
    "primary_research_points",
    "source_items",
    "chapter_mappings",
    "coverage_summary"
  ],
  "properties": {
    "primary_research_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_summary",
          "task_role",
          "parent_task_order",
          "parent_task_id",
          "normalized_problem",
          "chapter_technology",
          "source_order",
          "source_keywords",
          "expected_capability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_summary": {
            "type": "string"
          },
          "normalized_problem": {
            "type": "string"
          },
          "chapter_technology": {
            "type": "string"
          },
          "planned_chapter_id": {
            "type": "string"
          },
          "research_status_topic": {
            "type": "string"
          },
          "sub_item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "source_keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_capability": {
            "type": "string",
            "minLength": 1
          },
          "parent_task_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_task_order": {
            "type": "integer",
            "minimum": 1
          },
          "task_role": {
            "enum": [
              "technical-research",
              "engineering-implementation"
            ]
          }
        }
      },
      "description": "Compatibility field: each array item represents one research-content subpoint, not a whole parent research topic."
    },
    "source_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_type",
          "source_text",
          "normalized_requirement",
          "coverage_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_type": {
            "enum": [
              "research-content",
              "schedule-plan",
              "assessment-requirement",
              "expected-output",
              "user-supplement",
              "administrative"
            ]
          },
          "source_text": {
            "type": "string"
          },
          "normalized_requirement": {
            "type": "string"
          },
          "research_point_id": {
            "type": "string"
          },
          "planned_chapter_id": {
            "type": "string"
          },
          "planned_section": {
            "type": "string"
          },
          "content_role": {
            "enum": [
              "problem",
              "method",
              "implementation",
              "formula",
              "experiment",
              "metric",
              "result",
              "boundary",
              "appendix-evidence",
              "non-body-evidence"
            ]
          },
          "evidence_needed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage_status": {
            "enum": [
              "unmapped",
              "planned",
              "drafted",
              "confirmed",
              "covered-by-appendix",
              "not-applicable",
              "administrative"
            ]
          },
          "confirmed_location": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "parent_task_id": {
            "type": "string",
            "minLength": 1
          },
          "task_role": {
            "enum": [
              "technical-research",
              "engineering-implementation"
            ]
          },
          "assessment_name": {
            "type": "string"
          },
          "target_value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "test_conditions": {
            "type": "string"
          },
          "evidence_status": {
            "enum": [
              "target-only",
              "test-designed",
              "evidence-partial",
              "evidence-confirmed",
              "not-applicable"
            ]
          },
          "content_form": {
            "enum": [
              "indicator-definition",
              "formula",
              "test-setting",
              "result-table",
              "judgement-rule",
              "boundary-statement",
              "mixed"
            ]
          },
          "evidence_section": {
            "type": "string"
          },
          "prose_realization": {
            "enum": [
              "technical-target",
              "design-constraint",
              "performance-description",
              "condition-and-threshold",
              "result-evidence",
              "boundary-statement",
              "mixed"
            ]
          },
          "source_identity_hidden": {
            "const": true
          },
          "assessment_kind": {
            "enum": [
              "quantitative",
              "qualitative",
              "mixed"
            ],
            "description": "Classify task-book assessment requirements by evidence form. Qualitative requirements must later have a capability/function/result statement, not be dropped because they lack a numeric threshold."
          },
          "qualitative_result_expectation": {
            "type": "string",
            "description": "For qualitative or mixed assessment requirements, summarize what observable capability/function/outcome would count as the corresponding result."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_type": {
                  "enum": [
                    "research-content",
                    "schedule-plan",
                    "assessment-requirement",
                    "expected-output",
                    "user-supplement"
                  ]
                }
              },
              "required": [
                "source_type"
              ]
            },
            "then": {
              "required": [
                "research_point_id",
                "parent_task_id",
                "task_role"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source_type": {
                  "const": "assessment-requirement"
                }
              },
              "required": [
                "source_type"
              ]
            },
            "then": {
              "required": [
                "assessment_name",
                "assessment_kind",
                "planned_section",
                "content_form",
                "evidence_status",
                "prose_realization",
                "source_identity_hidden"
              ]
            }
          }
        ]
      }
    },
    "chapter_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "research_point_id",
          "task_role",
          "parent_task_order",
          "parent_task_id",
          "chapter_id",
          "chapter_problem",
          "chapter_technology",
          "research_status_topic",
          "source_item_ids",
          "source_order",
          "chapter_title",
          "title_alignment_basis",
          "chapter_mainline_map",
          "innovation_title_plans",
          "technology_option_sets",
          "heading_source_term_plan",
          "assessment_coverage_plans",
          "standalone_validation_mode"
        ],
        "properties": {
          "research_point_id": {
            "type": "string"
          },
          "chapter_id": {
            "type": "string"
          },
          "chapter_problem": {
            "type": "string"
          },
          "chapter_technology": {
            "type": "string"
          },
          "research_status_topic": {
            "type": "string"
          },
          "source_item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "chapter_title": {
            "type": "string",
            "minLength": 1
          },
          "title_alignment_basis": {
            "type": "string",
            "minLength": 1
          },
          "innovation_title_plans": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "section_number",
                "title",
                "power_element",
                "source_item_ids",
                "parent_task_id",
                "technical_object",
                "technical_method",
                "technical_role",
                "specificity_basis",
                "research_subpoint_index",
                "derivation_basis",
                "specific_computing_technology",
                "technical_signature",
                "technology_specificity_basis",
                "technology_origin",
                "shared_chapter_question",
                "chain_order",
                "chain_role",
                "depends_on_previous",
                "parent_logic_link"
              ],
              "properties": {
                "section_number": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "power_element": {
                  "type": "string",
                  "minLength": 1
                },
                "source_item_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "supporting_heading_numbers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                },
                "parent_task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "technical_object": {
                  "type": "string",
                  "minLength": 1
                },
                "technical_method": {
                  "type": "string",
                  "minLength": 1
                },
                "technical_role": {
                  "type": "string",
                  "minLength": 1
                },
                "specificity_basis": {
                  "type": "string",
                  "minLength": 1
                },
                "research_subpoint_index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "derivation_basis": {
                  "type": "string",
                  "minLength": 1
                },
                "assessment_item_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "specific_computing_technology": {
                  "type": "string",
                  "minLength": 1,
                  "description": "细化到技术变体、关键结构、机制、约束或组合方式的具体计算技术；内部字段可以保留原始英文模型名/缩写以便追溯，但不得只填RAG、图神经网络/GNN、Transformer、强化学习、大模型等技术族名称。"
                },
                "technology_specificity_basis": {
                  "type": "string",
                  "minLength": 1,
                  "description": "说明该技术相对同技术族常规实现的区分性成分，例如混合检索+重排序、关系类型感知异构图注意力、时序门控或安全约束策略。不得只写“更具体/更先进”等空话。"
                },
                "technology_origin": {
                  "type": "string",
                  "enum": [
                    "source_confirmed",
                    "model_suggested",
                    "user_confirmed_design"
                  ]
                },
                "shared_chapter_question": {
                  "type": "string",
                  "minLength": 1
                },
                "chain_order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "chain_role": {
                  "type": "string",
                  "minLength": 1
                },
                "depends_on_previous": {
                  "type": "boolean"
                },
                "handoff_from_previous": {
                  "type": "string"
                },
                "output_to_next": {
                  "type": "string"
                },
                "technical_signature": {
                  "type": "string",
                  "minLength": 1,
                  "description": "必须直接出现在二/三级技术标题中的中文语义最小区分性技术签名；不得裸露英文模型名/英文缩写，应以简洁中文表达实际技术路线；不得只写RAG/GNN/Transformer等技术族，也不得只写Span抽取、双塔匹配、置信校准、参数更新等任务动作。"
                },
                "parent_logic_link": {
                  "type": "string",
                  "minLength": 1,
                  "description": "说明该X.i为何是当前一级标题核心问题的直接子问题、关键步骤或核心输出；不得只写“与本章相关”。"
                }
              }
            },
            "maxItems": 5
          },
          "parent_task_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_task_order": {
            "type": "integer",
            "minimum": 1
          },
          "task_role": {
            "enum": [
              "technical-research",
              "engineering-implementation"
            ]
          },
          "assessment_coverage_plans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assessment_item_id",
                "assessment_kind",
                "planned_section",
                "content_form",
                "evidence_status",
                "prose_realization",
                "source_identity_hidden"
              ],
              "properties": {
                "assessment_item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "planned_section": {
                  "type": "string",
                  "minLength": 1
                },
                "content_form": {
                  "enum": [
                    "indicator-definition",
                    "formula",
                    "test-setting",
                    "result-table",
                    "judgement-rule",
                    "boundary-statement",
                    "mixed"
                  ]
                },
                "evidence_status": {
                  "enum": [
                    "target-only",
                    "test-designed",
                    "evidence-partial",
                    "evidence-confirmed",
                    "not-applicable"
                  ]
                },
                "confirmed_location": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "evidence_section": {
                  "type": "string"
                },
                "prose_realization": {
                  "enum": [
                    "technical-target",
                    "design-constraint",
                    "performance-description",
                    "condition-and-threshold",
                    "result-evidence",
                    "boundary-statement",
                    "mixed"
                  ]
                },
                "source_identity_hidden": {
                  "const": true
                },
                "assessment_kind": {
                  "enum": [
                    "quantitative",
                    "qualitative",
                    "mixed"
                  ]
                },
                "result_realization": {
                  "type": "string",
                  "description": "Planned or confirmed result phrasing. Qualitative requirements must describe the demonstrated function/capability/outcome; quantitative requirements use the result value/finding rather than repeating the acceptance threshold."
                }
              }
            }
          },
          "standalone_validation_mode": {
            "enum": [
              "none",
              "large-data",
              "user-requested"
            ]
          },
          "standalone_validation_reason": {
            "type": "string"
          },
          "heading_source_term_plan": {
            "type": "array",
            "minItems": 1,
            "description": "将预期目标、进度计划和考核要求中的关键且有实际含义的技术词分散落入二、三级标题；概括性词落二级，窄技术点落三级。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_item_id",
                "source_type",
                "term",
                "granularity",
                "target_heading_number",
                "target_heading_title"
              ],
              "properties": {
                "source_item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_type": {
                  "enum": [
                    "expected-output",
                    "schedule-plan",
                    "assessment-requirement"
                  ]
                },
                "term": {
                  "type": "string",
                  "minLength": 1
                },
                "granularity": {
                  "enum": [
                    "broad",
                    "narrow"
                  ]
                },
                "target_heading_number": {
                  "type": "string",
                  "minLength": 1
                },
                "target_heading_title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "core_section_count": {
            "type": "integer",
            "minimum": 3,
            "maximum": 5,
            "default": 3,
            "description": "技术章核心二级标题数量，默认3；仅当预期目标/进度技术点无法合理归并时扩展到4—5。"
          },
          "core_section_expansion_reason": {
            "type": "string",
            "description": "仅core_section_count>3时填写，说明哪些来源目标无法合理归并。"
          },
          "chapter_mainline_map": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chapter_core_object",
              "chapter_core_problem",
              "chapter_core_output"
            ],
            "properties": {
              "chapter_core_object": {
                "type": "string",
                "minLength": 1,
                "description": "一级标题真正聚焦的核心研究对象，不写项目总体对象。"
              },
              "chapter_core_problem": {
                "type": "string",
                "minLength": 1,
                "description": "一级标题要解决的核心技术问题，用于判断二级标题是否仍在本章主线内。"
              },
              "chapter_core_output": {
                "type": "string",
                "minLength": 1,
                "description": "一级标题对应的核心技术输出/能力。"
              },
              "excluded_adjacent_topics": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "与项目相关但不属于当前章主线、应放入相邻或后续技术章的主题。"
              }
            }
          },
          "technology_option_sets": {
            "type": "array",
            "description": "User-visible technology alternatives generated together with the outline. Each unresolved core level-2 heading should normally have 2-3 boundary-consistent candidates. A source-locked technology may use source_locked=true and does not need artificial alternatives.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "section_number",
                "problem_or_role",
                "source_locked",
                "candidates",
                "selection_status"
              ],
              "properties": {
                "section_number": {
                  "type": "string",
                  "minLength": 1
                },
                "problem_or_role": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locked": {
                  "type": "boolean"
                },
                "candidates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "candidate_id",
                      "technology_name",
                      "technical_signature_cn",
                      "key_mechanisms",
                      "fit_reason",
                      "origin",
                      "recommended"
                    ],
                    "properties": {
                      "candidate_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "technology_name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Internal original technology name; English names are allowed here for traceability."
                      },
                      "technical_signature_cn": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Chinese route-semantic technical signature suitable for building a visible heading; do not expose raw English abbreviations in the final heading."
                      },
                      "key_mechanisms": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "fit_reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "origin": {
                        "enum": [
                          "source_confirmed",
                          "model_suggested"
                        ]
                      },
                      "scope_risk": {
                        "type": "string"
                      },
                      "recommended": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "recommended_candidate_id": {
                  "type": "string"
                },
                "selected_candidate_id": {
                  "type": "string"
                },
                "selection_status": {
                  "enum": [
                    "source_locked",
                    "recommended_pending_user_confirmation",
                    "user_confirmed"
                  ]
                }
              }
            }
          }
        }
      },
      "description": "One-to-one mappings from research-content subpoints to technical chapters beginning with Chapter 3."
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_items",
        "mapped_items",
        "confirmed_items",
        "unresolved_items"
      ],
      "properties": {
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "mapped_items": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_items": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_items": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "report_theme_type": {
      "enum": [
        "evaluation-related",
        "non-evaluation"
      ],
      "description": "模型依据报告核心研究主题自动判定；仅存在考核指标、验收要求、测试数据或实验安排不构成 evaluation-related。"
    }
  },
  "description": "Tracks task roles, source research-content subpoints, default-three/optional-expanded in-chapter research subpoints, outline technology options, schedule technologies, quantitative and qualitative assessment requirements, power-title coverage, and confirmed report locations."
}

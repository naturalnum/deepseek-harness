{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chapter Content Briefs Before Outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "targets", "items"],
  "properties": {
    "status": {"const": "confirmed"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_key", "suggested_title"],
        "properties": {
          "chapter_key": {"type": "string", "minLength": 1},
          "suggested_title": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_key", "approximate_content"],
        "properties": {
          "chapter_key": {"type": "string", "minLength": 1},
          "approximate_content": {"type": "string", "minLength": 1},
          "available_materials": {"type": "array"},
          "known_data_or_results": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  }
}

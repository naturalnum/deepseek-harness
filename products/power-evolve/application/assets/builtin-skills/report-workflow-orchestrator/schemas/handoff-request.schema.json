{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Child Skill Handoff Request",
  "type": "object",
  "required": [
    "orchestration",
    "skill_name",
    "action",
    "payload"
  ],
  "properties": {
    "orchestration": {
      "type": "object",
      "required": [
        "enabled",
        "request_id",
        "caller_skill"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "request_id": {
          "type": "string"
        },
        "caller_skill": {
          "const": "report-workflow-orchestrator"
        }
      },
      "additionalProperties": true
    },
    "skill_name": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

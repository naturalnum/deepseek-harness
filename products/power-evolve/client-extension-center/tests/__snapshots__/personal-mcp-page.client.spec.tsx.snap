exports[`Migrated personal MCP page with an explicit Port substitute > separates an old saved success from the edited configuration in Chinese 1`] = `
<div
  class="pext-mcp-check-result"
  data-check-state="succeeded"
  data-state="stale"
>
  <strong>
    当前配置尚未检查
  </strong>
  <small
    class="pext-mcp-check-stale"
  >
    历史检查结果，不适用于当前配置
  </small>
  <span>
    旧检查结果：检查成功；发现 2 个工具
  </span>
</div>
`;

exports[`Migrated personal MCP page with an explicit Port substitute > separates an old saved success from the edited configuration in English 1`] = `
<div
  class="pext-mcp-check-result"
  data-check-state="succeeded"
  data-state="stale"
>
  <strong>
    The current configuration has not been checked
  </strong>
  <small
    class="pext-mcp-check-stale"
  >

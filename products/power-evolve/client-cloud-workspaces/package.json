{
  "name": "@power-evolve/client-cloud-workspaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["lib", "README.md", "README.zh.md"],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "tsx --test tests/*.test.ts && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@power-evolve/contracts": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-remote-mock": "workspace:*",
    "@types/react": "~18.3.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "29.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}

FROM node:22.23.2-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

# The slim base lacks CA certificates; Debian archive keys verify this HTTP snapshot.
RUN printf '%s\n' \
    'Types: deb' \
    'URIs: http://snapshot.debian.org/archive/debian/20260901T000000Z' \
    'Suites: bookworm bookworm-updates' \
    'Components: main' \
    'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
    'Check-Valid-Until: no' \
    '' \
    'Types: deb' \
    'URIs: http://snapshot.debian.org/archive/debian-security/20260901T000000Z' \
    'Suites: bookworm-security' \
    'Components: main' \
    'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
    'Check-Valid-Until: no' \
    > /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    poppler-utils fontconfig fonts-liberation fonts-noto-cjk \
    fonts-wqy-zenhei fonts-texgyre \
  && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# The build context contains only runtime/, produced by assemble-office-preview.mjs.
COPY --chown=0:0 runtime/ /opt/power-evolve/
ENV HOME=/tmp TMPDIR=/tmp
WORKDIR /
USER 1000:1000

RUN test "$(node --version)" = "v22.23.2" \
  && test -x /usr/bin/pdfinfo \
  && fc-match 'Noto Sans CJK SC' | grep --fixed-strings 'NotoSansCJK'

# Verify all physical runtime bytes as the production user without starting a converter.
RUN node --input-type=module -e ' \
  import assert from "node:assert/strict"; \
  import { createHash } from "node:crypto"; \
  import { lstat, readFile, readdir } from "node:fs/promises"; \
  import { join } from "node:path"; \
  import { pathToFileURL } from "node:url"; \
  const root = "/opt/power-evolve"; \
  const inventoryName = "office-preview-closure.json"; \
  const actual = new Map(); \
  async function visit(path, relative = "") { \
    const status = await lstat(path); \
    assert.equal(status.isSymbolicLink(), false); \
    if (status.isDirectory()) { \
      assert.equal(status.mode & 0o777, 0o755); \
      for (const child of await readdir(path)) await visit(join(path, child), relative ? relative + "/" + child : child); \
    } else { \
      assert.equal(status.isFile(), true); \
      assert.equal(status.nlink, 1); \
      actual.set(relative, { status, bytes: await readFile(path) }); \
    } \
  } \
  await visit(root); \
  const inventory = JSON.parse(actual.get(inventoryName).bytes.toString("utf8")); \
  assert.equal(inventory.protocolVersion, 1); \
  assert.equal(inventory.sdkVersion, "0.1.1"); \
  assert.equal(inventory.backend, "wasm"); \
  assert.deepEqual(inventory.target, { platform: "linux", arch: process.arch }); \
  assert.ok(Array.isArray(inventory.files)); \
  const expected = new Set(); \
  for (const file of inventory.files) { \
    assert.equal(typeof file.path, "string"); \
    assert.ok(file.path.split("/").every(part => part && part !== "." && part !== "..")); \
    assert.equal(file.path.includes("\\"), false); \
    assert.equal(expected.has(file.path), false); \
    expected.add(file.path); \
    const entry = actual.get(file.path); \
    assert.ok(entry); \
    assert.equal(entry.bytes.byteLength, file.bytes); \
    assert.equal(entry.status.mode & 0o777, file.mode); \
    assert.equal(createHash("sha256").update(entry.bytes).digest("hex"), file.sha256); \
  } \
  assert.equal(actual.get(inventoryName).status.mode & 0o777, 0o644); \
  actual.delete(inventoryName); \
  assert.deepEqual([...actual.keys()].sort(), [...expected].sort()); \
  const dependencies = await (await import(pathToFileURL(join(root, "office-preview.mjs")))).loadOfficePreviewDependencies(); \
  assert.equal(dependencies.version, "0.1.1"); \
  console.log(JSON.stringify({ sdkVersion: dependencies.version, backend: "wasm", files: expected.size })); \
  '

ENTRYPOINT ["node", "/opt/power-evolve/office-preview.mjs"]

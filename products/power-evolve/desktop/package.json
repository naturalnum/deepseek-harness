{
  "name": "@power-evolve/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PowerEvolve Electron carrier for the shared native DSH application",
  "main": "lib/main.js",
  "files": [
    "lib",
    "README.md",
    "README.zh.md"

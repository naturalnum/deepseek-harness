+    'stdioTaskSchemasV2',
+  ]),
+  '@power-evolve/contracts/stdio-mcp-json': Object.freeze([
+    'stdioCanonicalJsonV2',
+  ]),
+  '@power-evolve/contracts/stdio-runtime': Object.freeze([
+    'stdioActionLeaseV2',
+    'stdioCloudStopEvidenceV2',
+    'stdioOutcomeV2',
+    'stdioRuntimeViewV2',
+    'stdioWorkerIdV2',
+  ]),
+  '@power-evolve/contracts/storage': Object.freeze([
+    'bindingGeneration',

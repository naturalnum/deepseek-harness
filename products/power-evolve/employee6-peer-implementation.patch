+})
+
+/** Add named product peers while retaining the official policy's other fields and entries.
+ * @param officialPolicy Unmodified repository dependency policy.
+ * @returns Independent cloud policy with the original SAFE and duplicate-safe references.
+ */
+export function createCloudPeerPolicy(officialPolicy) {
+  return { ...officialPolicy, peerRequiredHostExports: {
+    ...officialPolicy.peerRequiredHostExports, ...CLOUD_PEER_REQUIRED_HOST_EXPORTS,
+  } }
+}
+
+/** Validate cloud additions against actual product managed Host uses.
+ * @param policy Candidate cloud policy.
+ * @param officialPolicy Unmodified repository policy.
+ * @param managedHostExportUses Actual flat export uses from product managed Host facts.
+ * @param workspaceNames Actual official and product provider names.
+ * @returns Rejecting diagnostics; the combined official collector must also run.
+ */
+export function cloudPeerPolicyErrors(policy, officialPolicy, managedHostExportUses, workspaceNames) {
+  const failures = []
+  for (const field of new Set([...Object.keys(officialPolicy), ...Object.keys(policy)])) {
+    if (field !== 'peerRequiredHostExports' && !isDeepStrictEqual(policy[field], officialPolicy[field])) {
+      failures.push('Cloud peer policy must preserve official ' + field)
+    }
+  }
+  for (const [specifier, names] of Object.entries(officialPolicy.peerRequiredHostExports)) {
+    if (!isDeepStrictEqual(policy.peerRequiredHostExports?.[specifier], names)) {
+      failures.push('Cloud peer policy must preserve official peer entries for ' + specifier)
+    }
+  }
+  for (const [specifier, names] of Object.entries(policy.peerRequiredHostExports ?? {})) {
+    if (Object.hasOwn(officialPolicy.peerRequiredHostExports, specifier)) continue
+    const provider = specifier.split('/').slice(0, 2).join('/')
+    if (!specifier.startsWith('@power-evolve/') || !workspaceNames.has(provider)) {
+      failures.push('Cloud peer policy names unknown private provider ' + specifier)
+    }
+    if (!Array.isArray(names) || names.length === 0) {
+      failures.push('Cloud peer policy lists no named exports for ' + specifier)
+      continue
+    }
+    const seen = new Set()
+    for (const name of names) {
+      if (typeof name !== 'string' || !/^(?:[A-Za-z_$][\w$]*|default)$/u.test(name)) {
+        failures.push('Cloud peer policy cannot classify unbounded ' + specifier + '#' + name)
+        continue
+      }
+      if (seen.has(name)) failures.push('Cloud peer policy repeats ' + specifier + '#' + name)
+      seen.add(name)
+      if (!managedHostExportUses.some(use => use.specifier === specifier && use.exportName === name
+        && use.sourcePath.startsWith('products/power-evolve/'))) {
+        failures.push('Cloud peer policy lists unused product Host export ' + specifier + '#' + name)
+      }
+      if (officialPolicy.safeHostDependencyExports[specifier]?.includes(name)) {
+        failures.push('Cloud peer policy overlaps official SAFE export ' + specifier + '#' + name)
+      }
+    }
+  }
+  return failures
+}
+
+/** Require explicit production providers and matching consumer declarations.
+ * @param manifests Package-name map from the actual product manifests.
+ * @returns Rejecting declaration diagnostics; runtime path admission remains mandatory.
+ */
+export function cloudProtocolManifestErrors(manifests) {
+  const failures = []
+  for (const name of ['@power-evolve/application', '@power-evolve/connector-runner']) {
+    const manifest = manifests[name]
+    if (manifest?.peerDependencies?.['@power-evolve/contracts'] !== 'workspace:~'
+      || manifest?.devDependencies?.['@power-evolve/contracts'] !== 'workspace:~'
+      || Object.hasOwn(manifest?.dependencies ?? {}, '@power-evolve/contracts')) {
+      failures.push(name + ': Contracts requires matching peer + dev workspace:~ declarations')
+    }
+    if (manifest?.dependencies?.zod !== '^4.4.3') failures.push(name + ': Zod must remain a production dependency')
+  }
+  for (const name of ['@power-evolve/host', '@power-evolve/platform']) {
+    for (const provider of ['@power-evolve/contracts', '@power-evolve/connector-runner']) {
+      if (manifests[name]?.dependencies?.[provider] !== 'workspace:~') {
+        failures.push(name + ': missing explicit production provider ' + provider)
+      }
+    }
+    if (manifests[name]?.dependencies?.zod !== '4.4.3') failures.push(name + ': missing pinned production Zod provider')
+  }
+  return failures
+}
+
+/** Admit a complete observed Node ESM protocol graph in one fresh isolate.
+ * @param input Actual provider entries, consumer peers, linked roots, expected uses and loaded ESM observations.
+ * @returns Rejecting diagnostics for missing routes, differing versions, paths or runtime identities.
+ */
+export function cloudProtocolResolutionErrors(input) {
+  const failures = []
+  const providerFor = specifier => input.providers[specifier.startsWith('@power-evolve/contracts/')
+    ? '@power-evolve/contracts' : specifier]
+  for (const name of ['@power-evolve/contracts', 'zod']) {
+    const provider = input.providers[name]
+    if (!provider?.mapped || !provider.declarer || !provider.packageDir || !provider.version) {
+      failures.push('Missing formal runtime provider ' + name)
+    }
+  }
+  for (const consumer of input.consumers) {
+    if (!consumer.needsContractsPeer) continue
+    if (consumer.peer !== 'workspace:~' || consumer.dev !== 'workspace:~' || consumer.dependency) {
+      failures.push('Missing matching Contracts peer for ' + consumer.name)
+    }
+    if (!input.linkedRoots.includes(consumer.root)) failures.push('Missing linkedRoot for ' + consumer.name)
+  }
+  if (input.expectedUses.length === 0) failures.push('Empty protocol import corpus')
+  for (const expected of input.expectedUses) {
+    const rows = input.observations.filter(row => row.sourcePath === expected.sourcePath
+      && row.specifier === expected.specifier)
+    if (rows.length !== 1) failures.push('Missing or duplicate ESM observation ' + expected.sourcePath + '#' + expected.specifier)
+  }
+  for (const row of input.observations) {
+    const provider = providerFor(row.specifier)
+    if (!provider) { failures.push('Unknown protocol provider ' + row.specifier); continue }
+    const target = provider.modules?.[row.specifier]
+    if (row.version !== provider.version) failures.push('Protocol version conflict at ' + row.sourcePath + '#' + row.specifier)
+    if (row.packageDir !== provider.packageDir || row.url !== provider.urls?.[row.specifier]) {
+      failures.push('Private protocol copy or differing ESM entry at ' + row.sourcePath + '#' + row.specifier)
+    }
+    if (!target || !row.module || !isDeepStrictEqual(Object.keys(row.module).sort(), Object.keys(target).sort())) {
+      failures.push('Missing or differing runtime exports at ' + row.sourcePath + '#' + row.specifier)
+      continue
+    }
+    for (const [name, value] of Object.entries(target)) {
+      if (row.module[name] !== value) failures.push('Protocol runtime identity differs at ' + row.sourcePath + '#' + name)
+    }
+  }
+  return failures
+}
diff --git a/products/power-evolve/application/tests/employee6-peer-policy.test.mjs b/products/power-evolve/application/tests/employee6-peer-policy.test.mjs
new file mode 100644
--- /dev/null
+++ b/products/power-evolve/application/tests/employee6-peer-policy.test.mjs
@@ -0,0 +1,107 @@
+/** Cloud-only peer classifications retain official rejecting semantics and provider declarations. */
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { test } from 'node:test'
+import { PACKAGE_DEPENDENCY_POLICY } from '../../../../scripts/package-dependency-policy.ts'
+import { collectRuntimeSourceExportUses, collectHostDependencyExportPolicyViolations,
+  readPackageDependencyState } from '../../../../scripts/verify-package-dependencies.ts'
+import { inventory } from '../../scripts/cloud-policy.mjs'
+import { CLOUD_PEER_REQUIRED_HOST_EXPORTS, createCloudPeerPolicy, cloudPeerPolicyErrors,
+  cloudProtocolManifestErrors } from '../../scripts/cloud-peer-policy.mjs'
+
+const root = resolve(import.meta.dirname, '../../../..')
+const corpus = inventory(root)
+const manifests = Object.fromEntries(corpus.manifests.map(file => {
+  const manifest = JSON.parse(readFileSync(resolve(root, file), 'utf8'))
+  return [manifest.name, manifest]
+}))
+const official = readPackageDependencyState(root, PACKAGE_DEPENDENCY_POLICY)
+const names = new Set([...official.workspaceNames, ...Object.keys(manifests)])
+const app = '@power-evolve/application'
+const actualUses = corpus.runtime.filter(file => file.startsWith('products/power-evolve/application/src/'))
+  .flatMap(file => collectRuntimeSourceExportUses(file, readFileSync(resolve(root, file), 'utf8'))
+    .map(use => ({ ...use, sourcePath: file,
+      packageName: use.specifier.startsWith('@') ? use.specifier.split('/').slice(0, 2).join('/') : use.specifier.split('/')[0] })))
+const facts = [...official.facts, { manifest: manifests[app], hostRuntimeExportUses: actualUses }]
+const policy = createCloudPeerPolicy(PACKAGE_DEPENDENCY_POLICY)
+const errors = candidate => cloudPeerPolicyErrors(candidate, PACKAGE_DEPENDENCY_POLICY, actualUses, names)
+const classifications = candidate => collectHostDependencyExportPolicyViolations(facts, names, candidate)
+const contracts = uses => uses.filter(use => use.specifier.startsWith('@power-evolve/contracts/'))
+const keys = table => Object.entries(table).flatMap(([specifier, entries]) => entries.map(name => specifier + '#' + name)).sort()
+
+// This assertion uses the real scanner, rather than a copied expected count or historical proposal table.
+test('the named cloud table equals every actual managed Host Contracts export use', () => {
+  const observed = [...new Set(contracts(actualUses).map(use => use.specifier + '#' + use.exportName))].sort()
+  assert(observed.length > 0)
+  assert.deepEqual(keys(CLOUD_PEER_REQUIRED_HOST_EXPORTS), observed)
+  assert.deepEqual(errors(policy), [])
+  assert.equal(classifications(policy).filter(error => error.includes('@power-evolve/contracts/')).length, 0)
+  assert(classifications(PACKAGE_DEPENDENCY_POLICY).some(error => error.includes('@power-evolve/contracts/')))
+  for (const file of ['stdio-v2-cloud-worker.ts', 'stdio-v2-cloud-capture.ts', 'stdio-v2-cloud-runtime.ts', 'stdio-v2-worker-store.ts']) {
+    assert(contracts(actualUses).some(use => use.sourcePath.endsWith('/' + file)), 'Missing new worker source ' + file)
+  }
+})
+
+test('the cloud overlay preserves every original policy field and official peer entry', () => {
+  for (const field of Object.keys(PACKAGE_DEPENDENCY_POLICY)) {
+    if (field !== 'peerRequiredHostExports') assert.equal(policy[field], PACKAGE_DEPENDENCY_POLICY[field])
+  }
+  for (const [specifier, entries] of Object.entries(PACKAGE_DEPENDENCY_POLICY.peerRequiredHostExports)) {
+    assert.equal(policy.peerRequiredHostExports[specifier], entries)
+  }
+  const changedSafe = { ...policy, safeHostDependencyExports: { ...policy.safeHostDependencyExports,
+    '@power-evolve/contracts/account': ['accountUserId'] } }
+  assert(errors(changedSafe).some(error => error.includes('preserve official safeHostDependencyExports')))
+  assert(errors({ ...policy, duplicateSafePackages: [...policy.duplicateSafePackages, '@power-evolve/contracts'] })
+    .some(error => error.includes('preserve official duplicateSafePackages')))
+  const changedPeer = structuredClone(policy)
+  delete changedPeer.peerRequiredHostExports['@deepseek-ai/dsh-session']
+  assert(errors(changedPeer).some(error => error.includes('preserve official peer entries')))
+})
+
+test('unused, unknown, duplicate and unbounded cloud additions reject', () => {
+  const candidate = structuredClone(policy)
+  candidate.peerRequiredHostExports['@power-evolve/contracts/account'].push('notAnActualExport', '*', '<side-effect>', 'accountUserId')
+  candidate.peerRequiredHostExports['@power-evolve/missing/wire'] = ['value']
+  const rejected = errors(candidate)
+  for (const marker of ['unused product Host export', 'unknown private provider', 'repeats', 'unbounded']) {
+    assert(rejected.some(error => error.includes(marker)), marker)
+  }
+  assert(classifications(candidate).some(error => error.includes('lists unused')))
+  assert(classifications(candidate).some(error => error.includes('cannot classify unbounded')))
+  const missingProvider = new Set(names)
+  missingProvider.delete('@power-evolve/contracts')
+  assert(cloudPeerPolicyErrors(policy, PACKAGE_DEPENDENCY_POLICY, actualUses, missingProvider)
+    .some(error => error.includes('unknown private provider')))
+  assert(cloudPeerPolicyErrors(policy, PACKAGE_DEPENDENCY_POLICY,
+    actualUses.map(use => ({ ...use, sourcePath: 'private-fixture/not-product.ts' })), names)
+    .some(error => error.includes('unused product Host export')))
+})
+
+test('namespace and side-effect runtime source imports remain unclassified', () => {
+  for (const text of ["export * from '@power-evolve/contracts/account'", "import '@power-evolve/contracts/account'"]) {
+    const unbounded = collectRuntimeSourceExportUses('negative.ts', text).map(use => ({ ...use,
+      packageName: '@power-evolve/contracts', sourcePath: 'products/power-evolve/application/src/negative.ts' }))
+    assert.equal(unbounded.length, 1)
+    const rejected = collectHostDependencyExportPolicyViolations([...facts,
+      { manifest: manifests[app], hostRuntimeExportUses: unbounded }], names, policy)
+    assert(rejected.some(error => error.includes('negative.ts') && error.includes('is not classified')))
+  }
+})
+
+test('missing matching peer declarations or root production providers reject independently', () => {
+  assert.deepEqual(cloudProtocolManifestErrors(manifests), [])
+  for (const [owner, section, name] of [
+    ['@power-evolve/application', 'peerDependencies', '@power-evolve/contracts'],
+    ['@power-evolve/application', 'devDependencies', '@power-evolve/contracts'],
+    ['@power-evolve/connector-runner', 'peerDependencies', '@power-evolve/contracts'],
+    ['@power-evolve/host', 'dependencies', '@power-evolve/contracts'],
+    ['@power-evolve/platform', 'dependencies', '@power-evolve/connector-runner'],
+    ['@power-evolve/host', 'dependencies', 'zod'],
+  ]) {
+    const missing = structuredClone(manifests)
+    delete missing[owner][section][name]
+    assert(cloudProtocolManifestErrors(missing).length > 0, owner + '#' + name)
+  }
+})

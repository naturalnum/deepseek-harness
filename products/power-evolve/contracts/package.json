{
  "name": "@power-evolve/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe PowerEvolve wire validation and identifiers",
  "files": [
    "lib",
    "README.md",
    "README.zh.md"
  ],
  "exports": {
    "./office-preview": {
      "types": "./lib/office-preview.d.ts",
      "default": "./lib/office-preview.js"
    },
    "./execution-resolution": {
      "types": "./lib/execution-resolution.d.ts",
      "default": "./lib/execution-resolution.js"
    },
    "./workspace-binding": {
      "types": "./lib/workspace-binding.d.ts",
      "default": "./lib/workspace-binding.js"
    },
    "./execution-files": {
      "types": "./lib/execution-files.d.ts",
      "default": "./lib/execution-files.js"
    },
    "./file-download": {
      "types": "./lib/file-download.d.ts",
      "default": "./lib/file-download.js"
    },
    "./account": {
      "types": "./lib/account.d.ts",
      "default": "./lib/account.js"
    },
    "./package.json": "./package.json",
    "./device-lifecycle": {
      "types": "./lib/device-lifecycle.d.ts",
      "default": "./lib/device-lifecycle.js"
    },
    "./device-execution": {
      "types": "./lib/device-execution.d.ts",
      "default": "./lib/device-execution.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "zod": "^4.4.3"
  }
}
